STACK_NAME=vulnverify-tools

# 私有镜像仓库地址，示例：192.168.10.20:5000
IMAGE_REGISTRY=127.0.0.1:5000
IMAGE_NAMESPACE=vulnverify
IMAGE_NAME=vulnverify-tools
IMAGE_TAG=latest

# 服务运行配置
TOOL_TOKEN=replace-with-a-strong-token
LOG_LEVEL=INFO
PUBLISHED_PORT=8001
DEPLOY_MODE=global
SERVICE_REPLICAS=3
WEB_CONCURRENCY=2
ENABLE_REQUEST_LOGGING=false
SCREENSHOT_MAX_CONCURRENCY=2
SCREENSHOT_EXECUTOR_WORKERS=2
SCREENSHOT_PAGE_LOAD_TIMEOUT=20
SCREENSHOT_ELEMENT_WAIT_TIMEOUT=10
SCREENSHOT_REQUEST_TIMEOUT=15
SCREENSHOT_MAX_SLEEP_TIME=3
SCREENSHOT_UPLOAD_ENABLED=true
SCREENSHOT_RETURN_BASE64_BY_DEFAULT=false
TERMINAL_HUB_RETURN_BASE64_BY_DEFAULT=false

# DNSLog provider: internal (default) | callback_red | dnslog_cn
DNSLOG_TYPE=internal
# 自建 DNSLog 服务器（DNSLOG_TYPE=internal 时使用），填你自建服务的真实值。
# DNSLOG_WEBSERVER=HTTP 地址 host:port；其主机 IP 即 DNS 服务器(UDP/53)。
DNSLOG_DOMAIN=<your-selfhosted-dnslog-domain>
DNSLOG_TOKEN=<your-dnslog-token>
DNSLOG_WEBSERVER=<your-dnslog-host:port>
CALLBACK_RED_BASE_URL=https://callback.red
DNSLOG_CN_BASE_URL=http://www.dnslog.cn

# `global` 模式会在每个符合约束的节点部署 1 个实例。
# `replicated` 模式则按 SERVICE_REPLICAS 控制副本数。
#
# 默认约束为 Linux 节点。如需仅部署到特定节点，可改为：
# PLACEMENT_CONSTRAINT='node.labels.vulnverify == true'
PLACEMENT_CONSTRAINT='node.platform.os == linux'

# 可选资源限制
RESERVE_CPUS=0.25
RESERVE_MEMORY=256M
LIMIT_CPUS=1.00
LIMIT_MEMORY=1G

# 可选浏览器配置
CHROMEDRIVER_PATH=/usr/bin/chromedriver
CHROMIUM_BINARY=/usr/bin/chromium

# 可选：限制 terminal hub 可调用的命令
# TERMINAL_HUB_ALLOWED_TOOLS=nmap,curl,ping,telnet
