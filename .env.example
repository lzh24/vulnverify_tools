TOOL_TOKEN=unified-tools-token-12345
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
WEB_CONCURRENCY=2
ENABLE_REQUEST_LOGGING=false
SCREENSHOT_MAX_CONCURRENCY=2
SCREENSHOT_EXECUTOR_WORKERS=2
SCREENSHOT_PAGE_LOAD_TIMEOUT=20
SCREENSHOT_ELEMENT_WAIT_TIMEOUT=10
SCREENSHOT_REQUEST_TIMEOUT=15
SCREENSHOT_MAX_SLEEP_TIME=3
SCREENSHOT_UPLOAD_ENABLED=true
SCREENSHOT_RETURN_BASE64_BY_DEFAULT=false
TERMINAL_HUB_RETURN_BASE64_BY_DEFAULT=false

# DNSLog provider: internal (default) | callback_red | dnslog_cn
# internal：私有化自建 DNSLog，填你自建服务的真实域名/token/webserver，勿用占位示例值。
#   DNSLOG_DOMAIN=自建 DNSLog 的根域名（如 h.example.com）
#   DNSLOG_TOKEN=自建 DNSLog 的访问 token
#   DNSLOG_WEBSERVER=自建 DNSLog 的 HTTP 服务地址 host:port；其主机 IP 同时也是 DNS 服务器
#     （UDP/53），dnslog_smoke.py 会直接用该 IP 做 DNS 解析验证，无需系统域名可达。
# callback_red：公共 callback.red DNSLog，仅需 CALLBACK_RED_BASE_URL
# dnslog_cn：公共 dnslog.cn DNSLog，仅需 DNSLOG_CN_BASE_URL
DNSLOG_TYPE=internal
DNSLOG_DOMAIN=<your-selfhosted-dnslog-domain>
DNSLOG_TOKEN=<your-dnslog-token>
DNSLOG_WEBSERVER=<your-dnslog-host:port>
CALLBACK_RED_BASE_URL=https://callback.red
DNSLOG_CN_BASE_URL=http://www.dnslog.cn

# ── 截图存储（MinIO / S3，私有化）──────────────────────────────
# 上传到本地 MinIO，返回对象 key，由协调中枢同源代理下载
# MINIO_ENDPOINT=http://minio:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=<minio 密码>
# MINIO_BUCKET=pentest-self-reports
# MINIO_REGION=us-east-1
# MINIO_PUBLIC=false   # true 返回预签名直链；false 返回对象 key（推荐）

# ChromeDriver 路径（可选）
# 如果不设置，工具会自动尝试以下方式：
# 1. 使用 webdriver-manager 自动下载和管理（推荐）
# 2. 查找系统常见路径
# 3. 让 Selenium 自动查找
#
# Mac Apple Silicon (M1/M2/M3):
# CHROMEDRIVER_PATH=/opt/homebrew/bin/chromedriver
# CHROMIUM_BINARY=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#
# Mac Intel:
# CHROMEDRIVER_PATH=/usr/local/bin/chromedriver
# CHROMIUM_BINARY=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#
# Linux:
# CHROMEDRIVER_PATH=/usr/bin/chromedriver
# CHROMIUM_BINARY=/usr/bin/chromium
#
# Windows:
# CHROMEDRIVER_PATH=C:\Program Files\chromedriver.exe
# CHROMIUM_BINARY=C:\Program Files\Google\Chrome\Application\chrome.exe
#
# 详细配置说明请参考: docs/Mac本地开发环境配置.md
# CHROMEDRIVER_PATH=
# CHROMIUM_BINARY=

# 限制工具使用
# TERMINAL_HUB_ALLOWED_TOOLS=nmap,curl,ping,telnet
