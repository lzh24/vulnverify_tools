# 工具认证 Token，用于验证 API 调用权限
# 默认值: unified-tools-token-12345
TOOL_TOKEN=your-secret-token-here

# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# 服务监听地址和端口
HOST=0.0.0.0
PORT=8000

# ChromeDriver 路径（可选）
# 如果不设置，工具会自动尝试以下方式：
# 1. 使用 webdriver-manager 自动下载和管理（推荐）
# 2. 查找系统常见路径
# 3. 让 Selenium 自动查找
#
# Mac Apple Silicon (M1/M2/M3):
# CHROMEDRIVER_PATH=/opt/homebrew/bin/chromedriver
# CHROMIUM_BINARY=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#
# Mac Intel:
# CHROMEDRIVER_PATH=/usr/local/bin/chromedriver
# CHROMIUM_BINARY=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#
# Linux:
# CHROMEDRIVER_PATH=/usr/bin/chromedriver
# CHROMIUM_BINARY=/usr/bin/chromium
#
# Windows:
# CHROMEDRIVER_PATH=C:\Program Files\chromedriver.exe
# CHROMIUM_BINARY=C:\Program Files\Google\Chrome\Application\chrome.exe
#
# 详细配置说明请参考: docs/Mac本地开发环境配置.md
# CHROMEDRIVER_PATH=
# CHROMIUM_BINARY=